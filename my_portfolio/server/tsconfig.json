{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",          // CommonJS works better with ts-node
    "moduleResolution": "Node",    // Node resolution works better with ts-node
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
